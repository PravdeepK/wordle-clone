# =============================================================================
# FakeWordle — example environment
#
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# Never commit real values. .env.local is gitignored.
#
# TWO SEPARATE SERVICES read from this file:
#   [next]  the Next.js app          (Vercel)
#   [ws]    ws-server/               (Fly / Railway / any long-running Node host)
# Vars are tagged below. A var set only on Vercel does NOT reach ws-server.
#
# NEXT_PUBLIC_* IS INLINED INTO THE BROWSER BUNDLE AT BUILD TIME.
# Anything with that prefix is public and permanently visible to end users.
# Never give a secret (API key, service-account credential) a NEXT_PUBLIC_ name.
# Everything without the prefix is server-only and must never reach the client.
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic (word generation + validation)
# -----------------------------------------------------------------------------

# REQUIRED [next] — server-only. SECRET, this is a billable API key.
# Consumed by /api/word (picks the secret word) and /api/validate (checks guesses).
# Both use claude-haiku-4-5 on every call; there is no static word list.
# If unset, the app does NOT hard-fail — it degrades quietly:
#   /api/word     -> falls back to small hardcoded word pools (still returns 200)
#   /api/validate -> fails open, accepting every guess as a valid word
# That degradation is easy to miss in testing, so set this for any real use.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE


# -----------------------------------------------------------------------------
# Firebase — client SDK (public, browser-exposed)
# -----------------------------------------------------------------------------
# All REQUIRED [next]. Read by config/firebaseConfig.ts for Auth + Firestore.
# These are NEXT_PUBLIC_ by design: Firebase web config is public by definition.
# Access is enforced by firestore.rules, NOT by keeping these secret.
# Without them, sign-in and all Firestore reads/writes fail.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID_HERE.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID_HERE.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID_HERE


# -----------------------------------------------------------------------------
# Firebase — Admin SDK (server-only, service account)
# -----------------------------------------------------------------------------
# All REQUIRED [next]. HIGHLY SENSITIVE — a service account bypasses
# firestore.rules entirely. Never expose these to the client, never prefix with
# NEXT_PUBLIC_, never commit them.
#
# Source: Firebase Console -> Project Settings -> Service Accounts
#         -> Generate new private key
#
# Consumed by five route handlers (each currently initializes its own admin app):
#   /api/auth/resolve-email        username -> email lookup for login
#   /api/auth/username-available   signup-time availability check
#   /api/custom-challenge          create/delete shared challenge links
#   /api/send-verification-email   generates the email-verification link
#   /api/send-password-reset-email generates the password-reset link
# If unset, all five routes return 500.

FIREBASE_ADMIN_PROJECT_ID=YOUR_PROJECT_ID_HERE
FIREBASE_ADMIN_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL_HERE

# Paste as a single line with literal \n escapes, wrapped in double quotes.
# The routes un-escape it via .replace(/\\n/g, "\n").
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"


# -----------------------------------------------------------------------------
# Resend (email)
# -----------------------------------------------------------------------------

# REQUIRED [next] — server-only. SECRET.
# Consumed by /api/send-verification-email, /api/send-password-reset-email,
# and /api/feedback. Unlike the gameplay routes, these HARD-FAIL with a 500
# rather than degrading, so the user knows the mail was never sent.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# REQUIRED [next] — server-only. Must be a domain verified in Resend.
# If unset, falls back to the placeholder "noreply@yourdomain.com", which
# Resend will reject — so treat it as required.
RESEND_FROM_EMAIL=noreply@YOUR_DOMAIN_HERE

# OPTIONAL [next] — server-only. Inbox that /api/feedback bug reports land in.
# If unset, falls back to the project owner's address hardcoded in the route.
FEEDBACK_TO_EMAIL=YOUR_EMAIL_HERE


# -----------------------------------------------------------------------------
# Site metadata
# -----------------------------------------------------------------------------

# OPTIONAL [next] — browser-exposed, not secret. Read by lib/site.ts.
# Canonical URL used for the OG image, sitemap.xml, and robots.txt.
# If unset, falls back to https://$VERCEL_URL, then to a hardcoded default.
# Set it explicitly in production so OG/canonical URLs aren't per-deployment.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN_HERE

# OPTIONAL [next] — browser-exposed, not secret. Read by lib/site.ts.
# Exactly the string "true" swaps the home page for the waitlist landing and
# changes robots/sitemap output. Any other value (or unset) = normal site.
NEXT_PUBLIC_COMING_SOON=false


# -----------------------------------------------------------------------------
# WebSocket server config (multiplayer)
# -----------------------------------------------------------------------------
# These two wire the app and ws-server to each other. Getting either wrong
# breaks multiplayer SILENTLY while solo play keeps working — check them first
# when "multiplayer is broken but the game works".

# REQUIRED in production [next] — browser-exposed, not secret.
# The wss:// URL of the deployed ws-server, read by app/multiplayer/useWebSocket.ts.
# Ignored on localhost (hardcoded to ws://localhost:3005) and rewritten
# automatically when testing from another device on the LAN.
NEXT_PUBLIC_WS_URL=wss://YOUR_WS_SERVER_HOST_HERE

# REQUIRED in production [ws] — set on the ws-server host, NOT on Vercel.
# Origin of the deployed Next.js app. ws-server calls {WORDLE_API_URL}/api/word
# to generate each match's word; it has no Anthropic key of its own.
# If unset, falls back to https://$VERCEL_URL, else http://localhost:3000 —
# so a wrong value in production means every match fails to start a word.
WORDLE_API_URL=https://YOUR_DOMAIN_HERE

# OPTIONAL [ws] — port ws-server listens on. Defaults to 3005 if unset.
# Most hosts inject this automatically; usually leave it unset.
PORT=3005


# -----------------------------------------------------------------------------
# Upstash Redis (durable rate limiting)
# -----------------------------------------------------------------------------
# Both OPTIONAL [next] — server-only. SECRET (the token grants DB access).
# Read by lib/rateLimit.ts, which guards every rate-limited route, including
# the two that spend real money on the Anthropic API: /api/word and
# /api/validate.
#
# Set BOTH or NEITHER. With both set, limits are durable: shared across
# serverless instances and surviving cold starts. With either missing, the
# limiter silently degrades to an in-memory Map that is per-instance and reset
# on every cold start, so the effective limit becomes `limit x instances`.
# That degradation is intentional for local dev, and unsafe in production.
#
# A Redis outage degrades the same way (logged to Sentry) rather than failing
# closed, so an Upstash incident cannot take the game down.
#
# Source: https://console.upstash.com -> create a Redis database ->
#         "REST API" tab -> UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
#         Pick the region closest to your Vercel deployment; the free tier is
#         far more than this app needs.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE_NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN_HERE


# -----------------------------------------------------------------------------
# Sentry (optional monitoring)
# -----------------------------------------------------------------------------
# Entirely optional. If no DSN is set, Sentry.init() is skipped altogether and
# the app runs normally with no error reporting.

# OPTIONAL [next] — browser-exposed, not secret (DSNs are safe to publish).
# Used by the client runtime, and as the fallback DSN for server + edge.
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# OPTIONAL [next] — server-only. Overrides the DSN for the server and edge
# runtimes only; takes precedence over NEXT_PUBLIC_SENTRY_DSN there.
# Set this only if you want server errors going to a different Sentry project.
SENTRY_DSN=

# OPTIONAL [next] — BUILD-TIME ONLY, server-only. Used by next.config.mjs
# (withSentryConfig) to upload source maps during `next build`.
# If unset, the build still succeeds; stack traces just stay unminified-unfriendly.
SENTRY_ORG=YOUR_SENTRY_ORG_SLUG_HERE
SENTRY_PROJECT=YOUR_SENTRY_PROJECT_SLUG_HERE


# =============================================================================
# Set automatically — do NOT put these in .env.local
# =============================================================================
# VERCEL_URL    Injected by Vercel. Fallback for NEXT_PUBLIC_SITE_URL (lib/site.ts)
#               and WORDLE_API_URL (ws-server).
# NODE_ENV      Set by Next/Node. "development" skips the email-verification gate
#               at login and enables a dev-only path in WordleHomePage.
# NEXT_RUNTIME  Set by Next. Selects the server vs edge Sentry config.
# =============================================================================
